# Настройки MAXimum Export. Скопируйте файл в .env и заполните:
#   cp .env.example .env
# Файл .env не попадает в git (см. .gitignore) — храните токен только там.

# Токен бота MAX (выдаёт @MasterBot / кабинет партнёра business.max.ru).
# Пусто — бот не запускается, работает только служебный HTTP API.
BOT_TOKEN=

# Адрес и порт служебного HTTP API (в compose доступен только с самой машины).
HOST=0.0.0.0
PORT=8080

# Курс валют: training — учебный (1 € = 100 ₽, по умолчанию), cbr — официальный курс ЦБ РФ.
RATE_SOURCE=training

# Откуда можно обращаться к API из браузера (CORS): адреса через запятую или *.
ALLOWED_ORIGINS=*

# true — если перед программой стоит обратный прокси (Caddy, nginx) с HTTPS.
# Тогда адрес клиента для ограничения частоты запросов берётся из X-Forwarded-For.
TRUST_PROXY=false
